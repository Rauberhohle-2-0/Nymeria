  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/Nymeria.Core/Nymeria.Core.csproj" />
    <ProjectReference Include="../../formats/Nymeria.Formats.Wav/Nymeria.Formats.Wav.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nymeria.Audio.Tests" />
  </ItemGroup>

</Project>
