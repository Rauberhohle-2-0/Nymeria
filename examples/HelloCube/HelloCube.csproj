<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Windows renders with DXIL bytecode, which Microsoft's DirectX Shader Compiler
    generates from Shaders/Cube.hlsl during the build and embeds below. macOS
    keeps the MSL source and never invokes a shader compiler, so DXIL generation
    is limited to Windows builds. The compiler is provisioned, checksum-verified,
    and cached by examples/Shared/DxilShaders.targets; set DxcPath to override it.
  -->
  <PropertyGroup>
    <DxilShaderOutputDirectory>$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', 'dxil'))</DxilShaderOutputDirectory>
    <DxilShadersEnabled Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">true</DxilShadersEnabled>
    <DxilShadersEnabled Condition="'$(DxilShadersEnabled)' == ''">false</DxilShadersEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/Nymeria.Core/Nymeria.Core.csproj" />
    <ProjectReference Include="../../src/graphics/Nymeria.Graphics/Nymeria.Graphics.csproj" />
    <ProjectReference Include="../../src/platform/Nymeria.Platform/Nymeria.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/FlyCameraControls.cs" Link="FlyCameraControls.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders/Cube.metal"
                      LogicalName="HelloCube.Shaders.Cube.metal" />
  </ItemGroup>

  <!-- Generated bytecode lives under the intermediate output directory and is
       never committed. -->
  <ItemGroup Condition="'$(DxilShadersEnabled)' == 'true'">
    <EmbeddedResource Include="$(DxilShaderOutputDirectory)/Cube.vert.dxil"
                      LogicalName="HelloCube.Shaders.Cube.vert.dxil" />
    <EmbeddedResource Include="$(DxilShaderOutputDirectory)/Cube.frag.dxil"
                      LogicalName="HelloCube.Shaders.Cube.frag.dxil" />
  </ItemGroup>

  <!-- One item per HLSL stage; the imported target compiles each of them. -->
  <ItemGroup Condition="'$(DxilShadersEnabled)' == 'true'">
    <NymeriaHlslShader Include="Shaders/Cube.hlsl"
                       Profile="vs_6_0"
                       EntryPoint="VSMain"
                       OutputName="Cube.vert.dxil" />
    <NymeriaHlslShader Include="Shaders/Cube.hlsl"
                       Profile="ps_6_0"
                       EntryPoint="PSMain"
                       OutputName="Cube.frag.dxil" />
  </ItemGroup>

  <Import Project="../Shared/DxilShaders.targets" />

</Project>
