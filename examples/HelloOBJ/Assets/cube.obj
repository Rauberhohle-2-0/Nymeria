# Nymeria HelloOBJ fixture: a 2x2x2 cube centered on the origin.
#
# This file is original project content and is redistributable with Nymeria.
# It uses six convex quads with outward counter-clockwise winding.
# The usemtl names are opaque labels; no MTL file is provided or loaded.

o Cube

v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v  1 -1 -1
v -1 -1 -1
v -1  1 -1
v  1  1 -1

vn 0  0  1
vn 0  0 -1
vn 1  0  0
vn -1 0  0
vn 0  1  0
vn 0 -1  0

vt 0 0
vt 1 0
vt 1 1
vt 0 1

usemtl front
f 1/1/1 2/2/1 3/3/1 4/4/1

usemtl back
f 5/1/2 6/2/2 7/3/2 8/4/2

usemtl right
f 2/1/3 5/2/3 8/3/3 3/4/3

usemtl left
f 6/1/4 1/2/4 4/3/4 7/4/4

usemtl top
f 4/1/5 3/2/5 8/3/5 7/4/5

usemtl bottom
f 6/1/6 5/2/6 2/3/6 1/4/6
