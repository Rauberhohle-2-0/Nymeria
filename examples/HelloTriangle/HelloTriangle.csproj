<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Windows renders with DXIL bytecode, which Microsoft's DirectX Shader Compiler
    (dxc) generates from Shaders/Triangle.hlsl during the build and embeds here.
    macOS keeps the MSL source and never invokes a shader compiler, so DXIL
    generation is limited to Windows builds. See
    docs/WINDOWS_03_HLSL_DXIL_SHADERS.md.
  -->
  <PropertyGroup>
    <DxilShaderOutputDirectory>$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', 'dxil'))</DxilShaderOutputDirectory>
    <DxilShadersEnabled Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">true</DxilShadersEnabled>
    <DxilShadersEnabled Condition="'$(DxilShadersEnabled)' == ''">false</DxilShadersEnabled>
    <!--
      Optional full path to dxc.exe, for example
      -p:DxcPath="C:\tools\dxc\bin\x64\dxc.exe". When it is empty, dxc is taken
      from PATH.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/graphics/Nymeria.Graphics/Nymeria.Graphics.csproj" />
    <ProjectReference Include="../../src/platform/Nymeria.Platform/Nymeria.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders/Triangle.metal"
                      LogicalName="HelloTriangle.Shaders.Triangle.metal" />
  </ItemGroup>

  <!-- Generated bytecode lives under the intermediate output directory and is
       never committed. -->
  <ItemGroup Condition="'$(DxilShadersEnabled)' == 'true'">
    <EmbeddedResource Include="$(DxilShaderOutputDirectory)/Triangle.vert.dxil"
                      LogicalName="HelloTriangle.Shaders.Triangle.vert.dxil" />
    <EmbeddedResource Include="$(DxilShaderOutputDirectory)/Triangle.frag.dxil"
                      LogicalName="HelloTriangle.Shaders.Triangle.frag.dxil" />
  </ItemGroup>

  <!--
    Compiles the two HelloTriangle stages to DXIL so the resources above exist
    before EmbeddedResource is turned into the assembly manifest. MSBuild skips
    this target while both outputs are newer than the HLSL source, and reruns it
    when the source changes or either output is missing.
  -->
  <Target Name="CompileHlslShadersToDxil"
          BeforeTargets="PrepareResourceNames"
          Condition="'$(DxilShadersEnabled)' == 'true'"
          Inputs="$(MSBuildProjectDirectory)/Shaders/Triangle.hlsl"
          Outputs="$(DxilShaderOutputDirectory)/Triangle.vert.dxil;$(DxilShaderOutputDirectory)/Triangle.frag.dxil">

    <PropertyGroup>
      <_DxcExecutable Condition="'$(DxcPath)' != ''">$(DxcPath)</_DxcExecutable>
      <_DxcExecutable Condition="'$(DxcPath)' == ''">dxc</_DxcExecutable>
    </PropertyGroup>

    <Error Condition="'$(DxcPath)' != '' and !Exists('$(DxcPath)')"
           Text="DxcPath is set to '$(DxcPath)', but no file exists there. Point it at dxc.exe from the DirectX Shader Compiler." />

    <!-- Probe once so a missing compiler fails with guidance instead of an Exec
         error that only names the command. -->
    <Exec Condition="'$(DxcPath)' == ''"
          Command="where.exe dxc"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_DxcProbeExitCode" />
    </Exec>

    <Error Condition="'$(DxcPath)' == '' and '$(_DxcProbeExitCode)' != '0'"
           Text="dxc was not found on PATH and DxcPath is not set, but a Windows build compiles Shaders/Triangle.hlsl to DXIL with Microsoft's DirectX Shader Compiler. Install a DXC release that supports shader model 6.0 (the Windows SDK ships dxc.exe), add its bin directory to PATH, or pass -p:DxcPath=&quot;C:\path\to\dxc.exe&quot;. macOS does not need dxc. See docs/WINDOWS_03_HLSL_DXIL_SHADERS.md." />

    <MakeDir Directories="$(DxilShaderOutputDirectory)" />

    <Exec Command="&quot;$(_DxcExecutable)&quot; -T vs_6_0 -E VSMain -Fo &quot;$(DxilShaderOutputDirectory)/Triangle.vert.dxil&quot; &quot;$(MSBuildProjectDirectory)/Shaders/Triangle.hlsl&quot;" />
    <Exec Command="&quot;$(_DxcExecutable)&quot; -T ps_6_0 -E PSMain -Fo &quot;$(DxilShaderOutputDirectory)/Triangle.frag.dxil&quot; &quot;$(MSBuildProjectDirectory)/Shaders/Triangle.hlsl&quot;" />
  </Target>

</Project>
