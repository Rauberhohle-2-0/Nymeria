<Project>

  <!--
    DXIL shader build: provisioning and compilation for SDL3's Direct3D 12
    backend. See docs/WINDOWS_03_1_DXC_PROVISIONING.md.

    A Windows build compiles HLSL to DXIL with Microsoft's DirectX Shader
    Compiler (dxc). Rather than requiring every developer to install it, this
    file provisions one pinned release into a per-user cache on first use:

      1. `DxcPath`, when set, always wins. It is validated, never provisioned.
      2. The provisioned cache is reused when it already holds the pinned
         version.
      3. A `dxc` already on PATH is used as-is, so offline machines with a
         compiler are never blocked.
      4. Otherwise the archive is downloaded from the pinned HTTPS URL, checked
         against the pinned SHA-256, and only then extracted. A download that
         fails the check is deleted and never executed.

    Nothing here runs on macOS: DXIL generation is gated on a Windows build, so
    the Metal path keeps its "no shader compiler" property and never downloads.

    Compiled output goes under the intermediate output directory and is never
    tracked; the cache lives outside the repository entirely (LOCALAPPDATA by
    default) and needs no administrator rights.
  -->

  <PropertyGroup>
    <!--
      The pinned toolchain. Both the URL and the digest identify one immutable
      release asset: changing either without re-verifying the archive would
      defeat the checksum check below.
    -->
    <NymeriaDxcVersion>1.9.2609</NymeriaDxcVersion>
    <NymeriaDxcArchiveName>dxc_2026_09_29.zip</NymeriaDxcArchiveName>
    <NymeriaDxcArchiveSha256>ad31b1fc8443175d204f77a611fdb3ef2ec42759bdc2f1167368de24a4a7e7f1</NymeriaDxcArchiveSha256>
    <NymeriaDxcDownloadUrl>https://github.com/microsoft/DirectXShaderCompiler/releases/download/v$(NymeriaDxcVersion)/$(NymeriaDxcArchiveName)</NymeriaDxcDownloadUrl>

    <!-- Per-user cache, outside the repository. Override to relocate it. -->
    <NymeriaDxcCacheRoot Condition="'$(NymeriaDxcCacheRoot)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\Nymeria\dxc</NymeriaDxcCacheRoot>
    <NymeriaDxcCacheRoot Condition="'$(NymeriaDxcCacheRoot)' == ''">$(UserProfile)\.nymeria\dxc</NymeriaDxcCacheRoot>

    <!-- The archive ships x64, x86, and arm64 builds; pick the host's. -->
    <NymeriaDxcArch Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">arm64</NymeriaDxcArch>
    <NymeriaDxcArch Condition="'$(PROCESSOR_ARCHITECTURE)' == 'x86'">x86</NymeriaDxcArch>
    <NymeriaDxcArch Condition="'$(NymeriaDxcArch)' == ''">x64</NymeriaDxcArch>

    <NymeriaDxcVersionRoot>$(NymeriaDxcCacheRoot)\$(NymeriaDxcVersion)</NymeriaDxcVersionRoot>
    <NymeriaDxcPointerFile>$(NymeriaDxcVersionRoot)\current.txt</NymeriaDxcPointerFile>
  </PropertyGroup>

  <!--
    Compiles every NymeriaHlslShader item to DXIL before the assembly manifest is
    built, so the generated bytecode can be embedded as a normal resource.

    Each item supplies Stage metadata through Profile and EntryPoint, the output
    file name, and the HLSL file itself:

      <NymeriaHlslShader Include="Shaders/Triangle.hlsl"
                         Profile="vs_6_0"
                         EntryPoint="VSMain"
                         OutputName="Triangle.vert.dxil" />

    MSBuild skips the target while every output is newer than every source, and
    reruns all stages when a source changes or an output is missing.
  -->
  <Target Name="CompileHlslShadersToDxil"
          BeforeTargets="PrepareResourceNames"
          Condition="'$(DxilShadersEnabled)' == 'true'"
          Inputs="@(NymeriaHlslShader)"
          Outputs="@(NymeriaHlslShader->'$(DxilShaderOutputDirectory)\%(OutputName)')">

    <!-- 1. An explicit override always wins and is validated here. -->
    <PropertyGroup>
      <NymeriaDxcExecutable Condition="'$(DxcPath)' != ''">$(DxcPath)</NymeriaDxcExecutable>
      <NymeriaDxcSource Condition="'$(DxcPath)' != ''">DxcPath</NymeriaDxcSource>
    </PropertyGroup>

    <Error Condition="'$(DxcPath)' != '' and !Exists('$(DxcPath)')"
           Text="DxcPath is set to '$(DxcPath)', but no file exists there. Point it at dxc.exe from the DirectX Shader Compiler, or clear it to let the build provision a pinned release." />

    <!-- 2. Reuse a previously provisioned and verified compiler. -->
    <ReadLinesFromFile Condition="'$(NymeriaDxcExecutable)' == '' and Exists('$(NymeriaDxcPointerFile)')"
                       File="$(NymeriaDxcPointerFile)">
      <Output TaskParameter="Lines" ItemName="_NymeriaDxcPointerLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_NymeriaDxcCachedDirectory>@(_NymeriaDxcPointerLines)</_NymeriaDxcCachedDirectory>
      <NymeriaDxcExecutable Condition="'$(NymeriaDxcExecutable)' == '' and Exists('$(_NymeriaDxcCachedDirectory)\bin\$(NymeriaDxcArch)\dxc.exe')">$(_NymeriaDxcCachedDirectory)\bin\$(NymeriaDxcArch)\dxc.exe</NymeriaDxcExecutable>
      <NymeriaDxcSource Condition="'$(NymeriaDxcExecutable)' != '' and '$(NymeriaDxcSource)' == ''">cache</NymeriaDxcSource>
    </PropertyGroup>

    <!-- 3. Fall back to a compiler the developer already installed. -->
    <Exec Condition="'$(NymeriaDxcExecutable)' == ''"
          Command="where.exe dxc"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_NymeriaDxcPathProbeExitCode" />
    </Exec>

    <PropertyGroup>
      <NymeriaDxcExecutable Condition="'$(NymeriaDxcExecutable)' == '' and '$(_NymeriaDxcPathProbeExitCode)' == '0'">dxc</NymeriaDxcExecutable>
      <NymeriaDxcSource Condition="'$(NymeriaDxcExecutable)' != '' and '$(NymeriaDxcSource)' == ''">PATH</NymeriaDxcSource>
    </PropertyGroup>

    <!-- 4. Provision the pinned release: download, verify, then extract. -->
    <PropertyGroup>
      <_NymeriaDxcPending Condition="'$(NymeriaDxcExecutable)' == ''">true</_NymeriaDxcPending>
      <!-- A fresh Guid per build keeps concurrent builds out of each other's
           archive and extraction directory. -->
      <_NymeriaDxcRunId Condition="'$(_NymeriaDxcPending)' == 'true'">$([System.Guid]::NewGuid().ToString('N'))</_NymeriaDxcRunId>
      <_NymeriaDxcDownloadDirectory Condition="'$(_NymeriaDxcPending)' == 'true'">$(NymeriaDxcCacheRoot)\downloads</_NymeriaDxcDownloadDirectory>
      <_NymeriaDxcDownloadFileName Condition="'$(_NymeriaDxcPending)' == 'true'">$(NymeriaDxcArchiveName).$(_NymeriaDxcRunId).zip</_NymeriaDxcDownloadFileName>
      <_NymeriaDxcArchivePath Condition="'$(_NymeriaDxcPending)' == 'true'">$(_NymeriaDxcDownloadDirectory)\$(_NymeriaDxcDownloadFileName)</_NymeriaDxcArchivePath>
      <_NymeriaDxcExtractionDirectory Condition="'$(_NymeriaDxcPending)' == 'true'">$(NymeriaDxcVersionRoot)\$(_NymeriaDxcRunId)</_NymeriaDxcExtractionDirectory>
    </PropertyGroup>

    <Message Condition="'$(_NymeriaDxcPending)' == 'true'" Importance="high"
             Text="Nymeria: downloading the DirectX Shader Compiler $(NymeriaDxcVersion) from $(NymeriaDxcDownloadUrl) into $(NymeriaDxcCacheRoot). This happens once per machine." />

    <MakeDir Condition="'$(_NymeriaDxcPending)' == 'true'" Directories="$(_NymeriaDxcDownloadDirectory)" />

    <DownloadFile Condition="'$(_NymeriaDxcPending)' == 'true'"
                  SourceUrl="$(NymeriaDxcDownloadUrl)"
                  DestinationFolder="$(_NymeriaDxcDownloadDirectory)"
                  DestinationFileName="$(_NymeriaDxcDownloadFileName)"
                  Retries="3"
                  RetryDelayMilliseconds="2000"
                  ContinueOnError="ErrorAndContinue" />

    <Error Condition="'$(_NymeriaDxcPending)' == 'true' and !Exists('$(_NymeriaDxcArchivePath)')"
           Text="Nymeria could not download the DirectX Shader Compiler $(NymeriaDxcVersion) from $(NymeriaDxcDownloadUrl), which DXIL shader compilation needs. If this machine is offline or behind a proxy, install DXC and pass -p:DxcPath=&quot;path\to\dxc.exe&quot;, or add dxc to PATH. Nothing was executed." />

    <GetFileHash Condition="'$(_NymeriaDxcPending)' == 'true' and Exists('$(_NymeriaDxcArchivePath)')"
                 Files="$(_NymeriaDxcArchivePath)"
                 Algorithm="SHA256"
                 HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_NymeriaDxcArchiveHashes" />
    </GetFileHash>

    <PropertyGroup Condition="'$(_NymeriaDxcPending)' == 'true' and Exists('$(_NymeriaDxcArchivePath)')">
      <_NymeriaDxcArchiveHash>%(_NymeriaDxcArchiveHashes.FileHash)</_NymeriaDxcArchiveHash>
      <!-- MSBuild string comparison is case-insensitive, and GetFileHash
           reports upper-case hex. -->
      <_NymeriaDxcArchiveVerified Condition="'$(_NymeriaDxcArchiveHash)' == '$(NymeriaDxcArchiveSha256)'">true</_NymeriaDxcArchiveVerified>
      <_NymeriaDxcArchiveRejected Condition="'$(_NymeriaDxcArchiveVerified)' != 'true'">true</_NymeriaDxcArchiveRejected>
    </PropertyGroup>

    <!-- A rejected archive is removed before the build stops, so no later step
         can extract or run it. -->
    <Delete Condition="'$(_NymeriaDxcArchiveRejected)' == 'true'" Files="$(_NymeriaDxcArchivePath)" />

    <Error Condition="'$(_NymeriaDxcArchiveRejected)' == 'true'"
           Text="Nymeria rejected the downloaded DirectX Shader Compiler archive: its SHA-256 is '$(_NymeriaDxcArchiveHash)' but the pinned value for $(NymeriaDxcArchiveName) is '$(NymeriaDxcArchiveSha256)'. The archive was deleted without being extracted or executed. Retry the build; if it fails again, check for a proxy or mirror that rewrote the download, or pass -p:DxcPath=&quot;path\to\dxc.exe&quot;." />

    <Unzip Condition="'$(_NymeriaDxcArchiveVerified)' == 'true'"
           SourceFiles="$(_NymeriaDxcArchivePath)"
           DestinationFolder="$(_NymeriaDxcExtractionDirectory)"
           ContinueOnError="ErrorAndContinue" />

    <!-- The archive keeps x86, x64, and arm64 side by side under bin\. -->
    <PropertyGroup>
      <_NymeriaDxcLayoutRejected Condition="'$(_NymeriaDxcArchiveVerified)' == 'true' and !Exists('$(_NymeriaDxcExtractionDirectory)\bin\$(NymeriaDxcArch)\dxc.exe')">true</_NymeriaDxcLayoutRejected>
    </PropertyGroup>

    <!-- Nothing from a rejected archive is kept, so a later build cannot read it
         as a cache hit. -->
    <Delete Condition="'$(_NymeriaDxcLayoutRejected)' == 'true'" Files="$(_NymeriaDxcArchivePath)" />
    <RemoveDir Condition="'$(_NymeriaDxcLayoutRejected)' == 'true'" Directories="$(_NymeriaDxcExtractionDirectory)" />

    <Error Condition="'$(_NymeriaDxcLayoutRejected)' == 'true'"
           Text="Nymeria verified $(NymeriaDxcArchiveName) but it did not contain bin\$(NymeriaDxcArch)\dxc.exe, so the pinned archive layout changed. The archive and its extraction were removed. Report this rather than working around it, and pass -p:DxcPath=&quot;path\to\dxc.exe&quot; to build now." />

    <!-- The pointer is written only after a verified extraction, and names a
         private directory, so a concurrent build can never execute a compiler
         that another build is still extracting. -->
    <WriteLinesToFile Condition="'$(_NymeriaDxcArchiveVerified)' == 'true' and Exists('$(_NymeriaDxcExtractionDirectory)\bin\$(NymeriaDxcArch)\dxc.exe')"
                      File="$(NymeriaDxcPointerFile)"
                      Lines="$(_NymeriaDxcExtractionDirectory)"
                      Overwrite="true" />

    <PropertyGroup>
      <NymeriaDxcExecutable Condition="'$(_NymeriaDxcArchiveVerified)' == 'true' and Exists('$(_NymeriaDxcExtractionDirectory)\bin\$(NymeriaDxcArch)\dxc.exe')">$(_NymeriaDxcExtractionDirectory)\bin\$(NymeriaDxcArch)\dxc.exe</NymeriaDxcExecutable>
      <NymeriaDxcSource Condition="'$(NymeriaDxcExecutable)' != '' and '$(NymeriaDxcSource)' == ''">download</NymeriaDxcSource>
    </PropertyGroup>

    <!-- The verified archive is no longer needed once extracted. -->
    <Delete Condition="Exists('$(_NymeriaDxcArchivePath)')" Files="$(_NymeriaDxcArchivePath)" />

    <Message Condition="'$(NymeriaDxcExecutable)' != ''" Importance="high"
             Text="Nymeria: compiling DXIL shaders with '$(NymeriaDxcExecutable)' (from $(NymeriaDxcSource); pinned DirectX Shader Compiler $(NymeriaDxcVersion))." />

    <!-- Compile every stage. MSBuild batches this task once per shader item. -->
    <MakeDir Condition="'$(NymeriaDxcExecutable)' != ''" Directories="$(DxilShaderOutputDirectory)" />

    <Exec Condition="'$(NymeriaDxcExecutable)' != ''"
          Command="&quot;$(NymeriaDxcExecutable)&quot; -T %(NymeriaHlslShader.Profile) -E %(NymeriaHlslShader.EntryPoint) -Fo &quot;$(DxilShaderOutputDirectory)\%(NymeriaHlslShader.OutputName)&quot; &quot;%(NymeriaHlslShader.FullPath)&quot;" />

  </Target>

</Project>
