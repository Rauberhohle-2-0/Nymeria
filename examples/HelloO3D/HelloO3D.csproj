<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/Nymeria.Core/Nymeria.Core.csproj" />
    <ProjectReference Include="../../src/formats/Nymeria.Formats.O3d/Nymeria.Formats.O3d.csproj" />
    <ProjectReference Include="../../src/graphics/Nymeria.Graphics/Nymeria.Graphics.csproj" />
    <ProjectReference Include="../../src/platform/Nymeria.Platform/Nymeria.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/FlyCameraControls.cs" Link="FlyCameraControls.cs" />
    <Compile Include="../Shared/ModelGpuGeometry.cs" Link="ModelGpuGeometry.cs" />
    <Compile Include="../Shared/ModelRenderer.cs" Link="ModelRenderer.cs" />
    <Compile Include="../Shared/ModelViewerApp.cs" Link="ModelViewerApp.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets/cube.o3d" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../Shared/Shaders/Model.metal"
                      LogicalName="Nymeria.Examples.Shaders.Model.metal" />
  </ItemGroup>

  <!-- Adds the build-generated Direct3D 12 bytecode for the shared model
       shader family; macOS is unaffected. -->
  <Import Project="../Shared/ModelShaders.targets" />

</Project>
