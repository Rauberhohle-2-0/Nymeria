<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/Nymeria.Core/Nymeria.Core.csproj" />
    <ProjectReference Include="../../src/formats/Nymeria.Formats.Obj/Nymeria.Formats.Obj.csproj" />
    <ProjectReference Include="../../src/formats/Nymeria.Formats.Textures/Nymeria.Formats.Textures.csproj" />
    <ProjectReference Include="../../src/graphics/Nymeria.Graphics/Nymeria.Graphics.csproj" />
    <ProjectReference Include="../../src/platform/Nymeria.Platform/Nymeria.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/FlyCameraControls.cs" Link="FlyCameraControls.cs" />
    <Compile Include="../Shared/MaterialGpuGeometry.cs" Link="MaterialGpuGeometry.cs" />
    <Compile Include="../Shared/MaterialRenderer.cs" Link="MaterialRenderer.cs" />
    <Compile Include="../Shared/BlendState.cs" Link="BlendState.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Shared/Shaders/Material.metal"
                      LogicalName="Nymeria.Examples.Shaders.Material.metal" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../HelloOBJ/Assets/cube.obj"
             Link="Assets/cube.obj"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HelloMaterials/Assets/checker.png"
             Link="Assets/checker.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Adds the build-generated Direct3D 12 bytecode for the shared material
       shader family; macOS is unaffected. -->
  <Import Project="../Shared/MaterialShaders.targets" />

</Project>
